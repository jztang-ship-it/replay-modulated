{
  "builds": [
    {
      "src": "api/*.ts",
      "use": "@vercel/node"
    },
    {
      "src": "basketball/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist",
        "buildCommand": "npm install && npm run build"
      }
    },
    {
      "src": "baseball/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist",
        "buildCommand": "npm install && npm run build"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.+)",
      "dest": "/api/$1"
    },
    { "handle": "filesystem" },
    {
      "src": "/baseball/(.*)",
      "dest": "/baseball/$1"
    },
    {
      "src": "/baseball",
      "dest": "/baseball/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/basketball/$1"
    }
  ]
}