{
  "buildCommand": "bash scripts/build-vercel.sh",
  "outputDirectory": "dist",
  "installCommand": "echo 'install handled by build-vercel.sh'",
  "rewrites": [
    { "source": "/basketball/((?!assets/|audio/|data/|headshots/).*)", "destination": "/basketball/index.html" },
    { "source": "/baseball/((?!assets/|audio/|data/|headshots/).*)",   "destination": "/baseball/index.html" },
    { "source": "/football/((?!assets/|audio/|data/|headshots/).*)",   "destination": "/football/index.html" },
    { "source": "/((?!api/|basketball/|baseball/|football/|assets/).*)", "destination": "/index.html" }
  ]
}
