{
    "compilerOptions": {
      "target": "ES2020",
      "module": "commonjs",
      "moduleResolution": "node",
      "esModuleInterop": true,
      "allowSyntheticDefaultImports": true,
      "strict": false,
      "skipLibCheck": true,
      "resolveJsonModule": true,
      "outDir": "./dist-sim"
    },
    "include": ["src/tools/**/*"],
    "exclude": ["node_modules"]
  }