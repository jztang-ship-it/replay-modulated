# Client-side (public — inlined into the Vite build; MUST be set in Vercel
# environment variables for production builds to have auth / analytics)
VITE_SUPABASE_URL=https://hnhrpwwznzokkfagfumb.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_HEADSHOT_BASE_URL=https://hnhrpwwznzokkfagfumb.supabase.co/storage/v1/object/public/headshots/nba
VITE_SUPABASE_AUDIO_URL=https://hnhrpwwznzokkfagfumb.supabase.co/storage/v1/object/public/audio
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
# Sentry — error monitoring. No-op when unset; set in Vercel for prod error
# reporting. Init lives in shared/lib/sentry.ts. Each sport's main.tsx calls
# initSentry() so events are tagged with sport.
VITE_SENTRY_DSN=

# Slate v2 — per-sport feature flag. Default OFF.
# Set to "true" (case-sensitive) to enable slate v2 deal-path filter for that sport.
# VITE_FEATURE_SLATE_V2_BASKETBALL=false
# VITE_FEATURE_SLATE_V2_BASEBALL=false
# VITE_FEATURE_SLATE_V2_FOOTBALL=false

# Server-side (secrets — set in Vercel dashboard; consumed by /api/* functions)
SUPABASE_URL=https://hnhrpwwznzokkfagfumb.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
KV_REST_API_URL=
KV_REST_API_TOKEN=
