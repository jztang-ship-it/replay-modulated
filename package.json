{
  "name": "ireplay-engine",
  "version": "1.0.0",
  "description": "Core backend logic for iReplay instant fantasy sports game",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "echo \"skip root build\"",
    "dev": "npm --prefix basketball run dev",
    "dev:basketball": "npm --prefix basketball run dev",
    "dev:baseball": "npm --prefix baseball run dev",
    "dev:worldcup": "npm --prefix worldcup run dev",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:visual": "node scripts/verify-h2h-play-layout.mjs",
    "digest": "node scripts/buildDigest.mjs"
  },
  "keywords": [
    "fantasy-sports",
    "game-engine",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.19.29",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "@vercel/node": "^5.6.10",
    "jsdom": "^29.1.1",
    "playwright": "^1.60.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "vitest": "^4.1.3"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.86.0",
    "@supabase/supabase-js": "^2.103.0",
    "@upstash/redis": "^1.37.0",
    "@vercel/functions": "^3.4.3",
    "@vercel/kv": "^3.0.0",
    "@vercel/og": "^0.6.3",
    "csv-parse": "^6.1.0",
    "openai": "^6.33.0"
  },
  "type": "module"
}
