backend/data/
node_modules/
dist/
.env
.env.local
.env.*
*.local
.DS_Store
*.log
*.zip
# Reasoning-Claude session-bootstrap zip from scripts/buildDigest.mjs
# (covered by *.zip above; listed explicitly so its purpose is greppable).
replaymod-digest-*.zip
*.tar.gz
*.tar
.vite/
.superpowers/
replaymod_src/
basketball/src/utils/culture_review.ts
baseball/src/utils/culture_review.ts
basketball/src/utils/culture_update.ts
baseball/src/utils/culture_update.ts
basketball/src/utils/culture_failed.json
baseball/src/utils/culture_failed.json
scripts/commentary-output-*.txt
football/public/debug-headshots/

# Culture-generation retry artifacts — output/state of generateCulture.ts
# when CULTURE_BATCH=tier2_retry (or any future _retry_ batch). The
# canonical targets JSON is tracked; the review/failed files regenerate
# every run and contain transient state.
basketball/src/utils/culture_*_retry_*.ts
basketball/src/utils/culture_*_retry_*.json

# Harness cache (Claude Code worktrees + tool state). Big, machine-local,
# never belongs in the repo.
.claude/

# One-off recalibration backups. Tag-and-keep if they ever matter; never
# tracked as working state.
*.bak.before-recalibration

# Headshot PNGs are managed via Supabase Storage, not git.
# Track only the canonical fallback silhouette (small, ships with code).
# safe-headshot-map.json is regenerated by refreshHeadshots.mjs alongside
# the PNGs, so it gets the same gitignore treatment.
basketball/public/headshots/*.png
basketball/public/headshots/safe-headshot-map.json
!basketball/public/headshots/_silhouette.png
